# Copie para .env (ignorado pelo git) e ajuste. Em produção, defina no painel do Render.

# Conexão com o PostgreSQL (Neon em produção). Formato JDBC:
DATABASE_URL=jdbc:postgresql://localhost:5432/buscarm
DB_USER=buscarm
DB_PASSWORD=buscarm

# Origens do frontend permitidas (CORS), separadas por vírgula:
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Segredo do JWT (Épico 3). Gere um valor aleatório forte:
# JWT_SECRET=troque-por-um-segredo-aleatorio-longo
