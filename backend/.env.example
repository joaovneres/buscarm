# Copie para .env (ignorado pelo git) e ajuste. Em produção, defina no painel do Render.
# Estas são as variáveis de RUNTIME do backend. Tokens de deploy NÃO ficam aqui.

# --- Banco (Neon / PostgreSQL) ---
# Local: jdbc:postgresql://localhost:5432/buscarm | Neon: use a conexão DIRETA com ?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/buscarm
DB_USER=buscarm
DB_PASSWORD=buscarm

# --- Segurança (JWT) ---
# Gere um valor aleatório forte (>= 32 bytes), ex.: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRATION_MINUTES=480

# --- Usuário ADMIN inicial (criado só se o banco não tiver nenhum usuário) ---
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@buscarm.local
ADMIN_PASSWORD=troque-esta-senha

# --- CORS: origens do frontend permitidas, separadas por vírgula ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
